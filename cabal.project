packages:
          ./examples/
          ./ghengin-core/
          ./linear-utils/
          ./ghengin/
          /home/admin/root/dep/hs-root/dep/ghc-tcplugins-extra
          /home/admin/root/dep/hs-root/dep/reference-counting/
          /home/admin/root/dep/hs-root/dep/fir

-------------------------------
-- DEBUG PATCHES
-------------------------------
          -- ~/Developer/vulkan
          -- ~/Developer/vector/vector
          -- ~/Developer/vector/vector-stream/
          -- ~/Developer/linear-base-fork/
          -- ~/Developer/fir/
          -- ~/Developer/gl-block/

-- profiling: true
-- package *
--     profiling-detail: late

package dear-imgui
  flags: +glfw +vulkan -sdl -opengl3

package fir
  flags: +internals +sop

constraints:
    linear-generics>0.2.2,
    QuickCheck>=2.15

allow-newer:
    base
  , template-haskell
  , filepath
  , fir:*
  , linear-base:*
  , dear-imgui:*
  , vector-sized:vector
  , wavefront:base
  , linear-apecs:*
  , typelits-witnesses:*
  , hashable:*
  , wavefront:text
  , bytestring
  , text
  , time
  , wavefront:time
  , containers
  , path
  , ghc
  , os-string

